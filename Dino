<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Динозаврик</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * {
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #f7f7f7;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
            overflow: hidden;
            touch-action: manipulation;
        }

        #gameContainer {
            width: 100%;
            max-width: 600px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        #gameCanvas {
            background: #fff;
            border-radius: 16px;
            border: 2px solid #ddd;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            width: 100%;
            height: auto;
            display: block;
            touch-action: none;
        }

        .hud {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            margin-top: 10px;
            padding: 0 6px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .hud-item {
            background: rgba(0, 0, 0, 0.05);
            padding: 6px 16px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: bold;
            color: #555;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .hud-item .value {
            color: #e67e22;
        }

        .hud-item .record {
            color: #f1c40f;
        }

        .hint {
            margin-top: 12px;
            font-size: 13px;
            color: #999;
            text-align: center;
            padding: 8px 16px;
            background: rgba(0, 0, 0, 0.03);
            border-radius: 12px;
        }

        .hint .emoji {
            margin-right: 4px;
        }

        @media (max-width: 480px) {
            .hud-item {
                font-size: 12px;
                padding: 4px 10px;
            }
            .hint {
                font-size: 11px;
            }
        }
    </style>
</head>
<body>

    <div id="gameContainer">
        <canvas id="gameCanvas" width="600" height="200"></canvas>

        <div class="hud">
            <div class="hud-item">
                🏆 Счёт: <span class="value" id="scoreDisplay">0</span>
            </div>
            <div class="hud-item">
                🥇 Рекорд: <span class="record" id="recordDisplay">0</span>
            </div>
        </div>

        <div class="hint">
            <span class="emoji">👆</span> Тапни по экрану, чтобы прыгнуть!
        </div>
    </div>

    <script>
        // ============================================================
        //  ИГРА «ДИНОЗАВРИК» ДЛЯ TELEGRAM WEB APP
        // ============================================================

        // Инициализация Telegram WebApp
        const tg = window.Telegram?.WebApp;
        if (tg) {
            tg.ready();
            tg.expand();
            tg.setHeaderColor('#f7f7f7');
            tg.setBackgroundColor('#f7f7f7');
        }

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const recordDisplay = document.getElementById('recordDisplay');

        const W = 600;
        const H = 200;
        canvas.width = W;
        canvas.height = H;

        // ============================================================
        //  НАСТРОЙКИ
        // ============================================================
        const GROUND_Y = 160;
        const GRAVITY = 0.7;
        const JUMP_POWER = -12;
        const DINO_X = 60;
        const DINO_W = 44;
        const DINO_H = 47;

        // ============================================================
        //  СОСТОЯНИЕ
        // ============================================================
        let gameRunning = false;
        let gameOver = false;
        let score = 0;
        let record = parseInt(localStorage.getItem('dinoRecord')) || 0;
        let speed = 5;
        let baseSpeed = 5;
        let maxSpeed = 14;

        let frame = 0;
        let spawnTimer = 0;
        let spawnInterval = 90;

        let dino = {
            x: DINO_X,
            y: GROUND_Y - DINO_H,
            vy: 0,
            isJumping: false,
            legFrame: 0,
        };

        let obstacles = [];
        let clouds = [];
        let groundOffset = 0;

        recordDisplay.textContent = record;

        // ============================================================
        //  ЗВУК
        // ============================================================
        let audioCtx = null;

        function playJumpSound() {
            try {
                if (!audioCtx) audioCtx = new(window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.value = 600;
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            } catch (e) {}
        }

        function playScoreSound() {
            try {
                if (!audioCtx) audioCtx = new(window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'square';
                osc.frequency.value = 800;
                gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.08);
            } catch (e) {}
        }

        function playDeathSound() {
            try {
                if (!audioCtx) audioCtx = new(window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.value = 200;
                osc.frequency.exponentialRampToValueAtTime(80, audioCtx.currentTime + 0.3);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } catch (e) {}
        }

        // ============================================================
        //  ИНИЦИАЛИЗАЦИЯ
        // ============================================================
        function resetGame() {
            gameRunning = true;
            gameOver = false;
            score = 0;
            speed = baseSpeed;
            frame = 0;
            spawnTimer = 0;
            spawnInterval = 90;
            dino.y = GROUND_Y - DINO_H;
            dino.vy = 0;
            dino.isJumping = false;
            obstacles = [];
            clouds = [];
            groundOffset = 0;
            scoreDisplay.textContent = '0';

            // Создаём облака
            for (let i = 0; i < 3; i++) {
                clouds.push({
                    x: Math.random() * W,
                    y: 20 + Math.random() * 60,
                    speed: 0.5 + Math.random() * 0.5,
                    size: 25 + Math.random() * 25,
                });
            }
        }

        // ============================================================
        //  ПРЫЖОК
        // ============================================================
        function jump() {
            if (!gameRunning || gameOver) {
                if (gameOver) resetGame();
                return;
            }
            if (!dino.isJumping) {
                dino.vy = JUMP_POWER;
                dino.isJumping = true;
                playJumpSound();
            }
        }

        // ============================================================
        //  СОЗДАНИЕ ПРЕПЯТСТВИЙ
        // ============================================================
        function spawnObstacle() {
            const types = ['cactus_small', 'cactus_big', 'bird'];
            const type = types[Math.floor(Math.random() * types.length)];

            if (type === 'cactus_small') {
                obstacles.push({
                    x: W,
                    y: GROUND_Y - 35,
                    w: 20,
                    h: 35,
                    type: 'cactus_small',
                });
            } else if (type === 'cactus_big') {
                obstacles.push({
                    x: W,
                    y: GROUND_Y - 50,
                    w: 28,
                    h: 50,
                    type: 'cactus_big',
                });
            } else {
                obstacles.push({
                    x: W,
                    y: GROUND_Y - 60 - Math.random() * 30,
                    w: 40,
                    h: 30,
                    type: 'bird',
                    wingFrame: 0,
                });
            }
        }

        // ============================================================
        //  ОБНОВЛЕНИЕ
        // ============================================================
        function update() {
            if (!gameRunning || gameOver) return;

            frame++;

            // Ускорение со временем
            speed = Math.min(maxSpeed, baseSpeed + Math.floor(score / 100));

            // Физика динозаврика
            dino.vy += GRAVITY;
            dino.y += dino.vy;

            if (dino.y >= GROUND_Y - DINO_H) {
                dino.y = GROUND_Y - DINO_H;
                dino.vy = 0;
                dino.isJumping = false;
            }

            // Анимация ног
            if (!dino.isJumping && frame % 6 === 0) {
                dino.legFrame = (dino.legFrame + 1) % 2;
            }

            // Движение земли
            groundOffset = (groundOffset + speed) % 20;

            // Движение облаков
            for (const cloud of clouds) {
                cloud.x -= cloud.speed;
                if (cloud.x + cloud.size < 0) {
                    cloud.x = W + cloud.size;
                    cloud.y = 20 + Math.random() * 60;
                }
            }

            // Генерация препятствий
            spawnTimer++;
            if (spawnTimer >= spawnInterval) {
                spawnTimer = 0;
                spawnObstacle();
                // Интервал уменьшается со временем
                spawnInterval = Math.max(45, 90 - Math.floor(score / 50));
            }

            // Движение препятствий
            for (let i = obstacles.length - 1; i >= 0; i--) {
                const obs = obstacles[i];
                obs.x -= speed;

                // Анимация крыльев птицы
                if (obs.type === 'bird') {
                    obs.wingFrame = (obs.wingFrame + 0.15) % 2;
                }

                // Удаляем ушедшие за экран
                if (obs.x + obs.w < 0) {
                    obstacles.splice(i, 1);
                    continue;
                }

                // Столкновение
                if (
                    dino.x + 6 < obs.x + obs.w - 4 &&
                    dino.x + DINO_W - 6 > obs.x + 4 &&
                    dino.y + 6 < obs.y + obs.h - 4 &&
                    dino.y + DINO_H - 6 > obs.y + 4
                ) {
                    gameOverHandler();
                    return;
                }
            }

            // Очки
            score += 0.15;
            scoreDisplay.textContent = Math.floor(score);
        }

        // ============================================================
        //  КОНЕЦ ИГРЫ
        // ============================================================
        function gameOverHandler() {
            gameOver = true;
            gameRunning = false;
            playDeathSound();

            if (navigator.vibrate) navigator.vibrate(200);

            const finalScore = Math.floor(score);
            if (finalScore > record) {
                record = finalScore;
                localStorage.setItem('dinoRecord', String(record));
                recordDisplay.textContent = record;
            }

            // Отправляем счёт в Telegram-бот (если открыто через WebApp)
            if (tg && tg.sendData) {
                try {
                    tg.sendData(`score:${finalScore}`);
                } catch (e) {}
            }
        }

        // ============================================================
        //  ОТРИСОВКА
        // ============================================================
        function drawDino() {
            const x = dino.x;
            const y = dino.y;
            const w = DINO_W;
            const h = DINO_H;

            ctx.fillStyle = '#4a4a4a';

            // Тело
            ctx.fillRect(x + 8, y + 12, w - 16, h - 22);

            // Голова
            ctx.fillRect(x + 22, y, w - 22, 18);

            // Глаз
            ctx.fillStyle = '#fff';
            ctx.fillRect(x + 32, y + 5, 4, 4);
            ctx.fillStyle = '#000';
            ctx.fillRect(x + 33, y + 6, 2, 2);

            // Рот
            ctx.fillStyle = '#4a4a4a';
            ctx.fillRect(x + w - 4, y + 12, 6, 3);

            // Ноги
            ctx.fillStyle = '#4a4a4a';
            if (dino.isJumping) {
                // В прыжке — ноги поджаты
                ctx.fillRect(x + 12, y + h - 10, 8, 8);
                ctx.fillRect(x + 24, y + h - 10, 8, 8);
            } else {
                // Бег — ноги двигаются
                if (dino.legFrame === 0) {
                    ctx.fillRect(x + 10, y + h - 12, 8, 12);
                    ctx.fillRect(x + 24, y + h - 8, 8, 8);
                } else {
                    ctx.fillRect(x + 10, y + h - 8, 8, 8);
                    ctx.fillRect(x + 24, y + h - 12, 8, 12);
                }
            }

            // Хвост
            ctx.fillRect(x, y + 18, 10, 6);

            // Рука
            ctx.fillRect(x + 30, y + 22, 8, 4);
        }

        function drawObstacles() {
            for (const obs of obstacles) {
                if (obs.type === 'cactus_small' || obs.type === 'cactus_big') {
                    // Кактус
                    ctx.fillStyle = '#3d8b3d';
                    ctx.fillRect(obs.x, obs.y, obs.w, obs.h);

                    // Тёмная обводка
                    ctx.fillStyle = '#2a5e2a';
                    ctx.fillRect(obs.x, obs.y, 4, obs.h);
                    ctx.fillRect(obs.x + obs.w - 4, obs.y, 4, obs.h);

                    // Иголки
                    ctx.fillStyle = '#2a5e2a';
                    for (let i = 0; i < 4; i++) {
                        ctx.fillRect(obs.x - 2, obs.y + 6 + i * 10, 4, 2);
                        ctx.fillRect(obs.x + obs.w - 2, obs.y + 6 + i * 10, 4, 2);
                    }
                } else if (obs.type === 'bird') {
                    // Птица
                    ctx.fillStyle = '#333';

                    // Тело
                    ctx.beginPath();
                    ctx.ellipse(obs.x + obs.w / 2, obs.y + obs.h / 2, obs.w / 2, obs.h / 2, 0, 0, Math.PI * 2);
                    ctx.fill();

                    // Крылья (машут)
                    ctx.fillStyle = '#555';
                    if (obs.wingFrame < 1) {
                        ctx.beginPath();
                        ctx.moveTo(obs.x + obs.w / 2, obs.y + obs.h / 2);
                        ctx.lineTo(obs.x - 5, obs.y - 5);
                        ctx.lineTo(obs.x + obs.w / 2 + 5, obs.y + obs.h / 2);
                        ctx.fill();
                    } else {
                        ctx.beginPath();
                        ctx.moveTo(obs.x + obs.w / 2, obs.y + obs.h / 2);
                        ctx.lineTo(obs.x - 5, obs.y + obs.h + 5);
                        ctx.lineTo(obs.x + obs.w / 2 + 5, obs.y + obs.h / 2);
                        ctx.fill();
                    }

                    // Глаз
                    ctx.fillStyle = '#fff';
                    ctx.beginPath();
                    ctx.arc(obs.x + obs.w - 8, obs.y + obs.h / 2 - 3, 2, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = '#000';
                    ctx.beginPath();
                    ctx.arc(obs.x + obs.w - 7, obs.y + obs.h / 2 - 3, 1, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
        }

        function drawGround() {
            ctx.fillStyle = '#4a4a4a';
            ctx.fillRect(0, GROUND_Y, W, 2);

            // Камешки/трещины на земле
            ctx.fillStyle = '#888';
            for (let i = 0; i < 20; i++) {
                const x = ((i * 30) - groundOffset) % (W + 30);
                ctx.fillRect(x, GROUND_Y + 4, 8, 2);
                ctx.fillRect(x + 12, GROUND_Y + 8, 4, 2);
            }
        }

        function drawClouds() {
            for (const cloud of clouds) {
                ctx.fillStyle = 'rgba(180, 200, 220, 0.6)';
                ctx.beginPath();
                ctx.ellipse(cloud.x, cloud.y, cloud.size, cloud.size * 0.6, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.beginPath();
                ctx.ellipse(cloud.x + cloud.size * 0.7, cloud.y - 5, cloud.size * 0.7, cloud.size * 0.5, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.beginPath();
                ctx.ellipse(cloud.x - cloud.size * 0.7, cloud.y + 3, cloud.size * 0.6, cloud.size * 0.45, 0, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function draw() {
            // Фон
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, W, H);

            // Облака
            drawClouds();

            // Земля
            drawGround();

            // Препятствия
            drawObstacles();

            // Динозаврик
            drawDino();

            // Экран смерти
            if (gameOver) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
                ctx.fillRect(0, 0, W, H);

                ctx.fillStyle = '#555';
                ctx.font = 'bold 28px monospace';
                ctx.textAlign = 'center';
                ctx.fillText('ИГРА ОКОНЧЕНА', W / 2, 70);

                ctx.font = '16px monospace';
                ctx.fillStyle = '#e67e22';
                ctx.fillText(`Счёт: ${Math.floor(score)}`, W / 2, 100);

                if (Math.floor(score) >= record) {
                    ctx.fillStyle = '#f1c40f';
                    ctx.font = 'bold 18px monospace';
                    ctx.fillText('🏆 НОВЫЙ РЕКОРД!', W / 2, 128);
                }

                ctx.font = '14px monospace';
                ctx.fillStyle = '#888';
                ctx.fillText('Тапни, чтобы начать заново', W / 2, 155);
            }
        }

        // ============================================================
        //  ЦИКЛ
        // ============================================================
        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        // ============================================================
        //  УПРАВЛЕНИЕ
        // ============================================================
        canvas.addEventListener('mousedown', (e) => {
            e.preventDefault();
            jump();
        });

        canvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            jump();
        }, { passive: false });

        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' || e.code === 'ArrowUp') {
                e.preventDefault();
                jump();
            }
        });

        // ============================================================
        //  ЗАПУСК
        // ============================================================
        resetGame();
        gameLoop();

        console.log('🦖 Динозаврик запущен!');
        console.log('👆 Тапни по экрану, чтобы прыгнуть');
    </script>
</body>
</html>
